#include <windows.h>
#include "resource.h"

IDI_APP      ICON "icons/app.ico"
IDI_TRAY_ON  ICON "icons/tray_on.ico"
IDI_TRAY_OFF ICON "icons/tray_off.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "kbswitch.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "KBSwitch - English/Ukrainian layout fixer"
      VALUE "ProductName", "KBSwitch"
      VALUE "FileVersion", "2.0"
      VALUE "ProductVersion", "2.0"
      VALUE "OriginalFilename", "KBSwitch.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
